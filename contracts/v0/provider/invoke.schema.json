{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.unzoo.ai/v0/provider/invoke.schema.json",
  "title": "Provider 请求",
  "description": "Core 打给 Provider 的三种请求。invoke 必带幂等键；get_action 用于 reconcile；cancel_action 幂等，重复取消不是错误。",

  "oneOf": [
    { "$ref": "#/$defs/invoke_request" },
    { "$ref": "#/$defs/get_action_request" },
    { "$ref": "#/$defs/cancel_action_request" }
  ],

  "$defs": {
    "invoke_request": {
      "type": "object",
      "required": [
        "schema_version",
        "method",
        "action_id",
        "tool_call_id",
        "task_id",
        "run_id",
        "step_id",
        "tool",
        "arguments",
        "arguments_hash",
        "idempotency_key",
        "grant"
      ],
      "properties": {
        "schema_version": { "const": "provider_invoke.v0" },
        "method": { "const": "invoke" },

        "action_id": {
          "description": "由 Core 生成。Provider 用它回报结果，也用它支持 reconcile。",
          "$ref": "https://contracts.unzoo.ai/v0/common/primitives.schema.json#/$defs/action_id"
        },
        "tool_call_id": {
          "$ref": "https://contracts.unzoo.ai/v0/common/primitives.schema.json#/$defs/tool_call_id"
        },
        "task_id": {
          "$ref": "https://contracts.unzoo.ai/v0/common/primitives.schema.json#/$defs/task_id"
        },
        "run_id": {
          "$ref": "https://contracts.unzoo.ai/v0/common/primitives.schema.json#/$defs/run_id"
        },
        "step_id": {
          "$ref": "https://contracts.unzoo.ai/v0/common/primitives.schema.json#/$defs/step_id"
        },

        "tool": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object" },
        "arguments_hash": {
          "description": "Provider 执行前自己重算一次并比对。对不上就拒绝——这是 TOCTOU 的最后一道闸。",
          "$ref": "https://contracts.unzoo.ai/v0/common/primitives.schema.json#/$defs/sha256"
        },

        "idempotency_key": {
          "$ref": "https://contracts.unzoo.ai/v0/common/primitives.schema.json#/$defs/idempotency_key"
        },

        "grant": {
          "description": "整份 Grant 随请求下发。Provider 不信任调用方，必须独立校验范围、有效期和撤销状态。",
          "$ref": "https://contracts.unzoo.ai/v0/security/capability-grant.schema.json"
        },

        "deadline_ms": { "type": "integer", "minimum": 0 },
        "evidence_policy": {
          "$ref": "https://contracts.unzoo.ai/v0/security/risk.schema.json#/$defs/evidence_policy"
        }
      }
    },

    "get_action_request": {
      "description": "超时之后先查，再决定要不要重试。涉及副作用时不得跳过这一步。",
      "type": "object",
      "required": ["schema_version", "method", "action_id"],
      "properties": {
        "schema_version": { "const": "provider_invoke.v0" },
        "method": { "const": "get_action" },
        "action_id": {
          "$ref": "https://contracts.unzoo.ai/v0/common/primitives.schema.json#/$defs/action_id"
        }
      }
    },

    "cancel_action_request": {
      "type": "object",
      "required": ["schema_version", "method", "action_id"],
      "properties": {
        "schema_version": { "const": "provider_invoke.v0" },
        "method": { "const": "cancel_action" },
        "action_id": {
          "$ref": "https://contracts.unzoo.ai/v0/common/primitives.schema.json#/$defs/action_id"
        },
        "grace_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
