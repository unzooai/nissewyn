{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.unzoo.ai/v0/provider/manifest.schema.json",
  "title": "Provider Manifest",
  "description": "Provider 向 Core 声明自己是谁、能做什么、每个工具有多危险。Unterm（Terminal）和 Unzoo（Browser/Computer）是同级 Provider，用同一份 manifest 格式。",

  "type": "object",
  "required": [
    "schema_version",
    "provider_id",
    "name",
    "version",
    "protocol_versions",
    "endpoint",
    "identity",
    "tools"
  ],
  "properties": {
    "schema_version": { "const": "provider_manifest.v0" },

    "provider_id": {
      "$ref": "https://contracts.unzoo.ai/v0/common/primitives.schema.json#/$defs/provider_id"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "optional": {
      "description": "为 true 表示这个 Provider 可以不安装，链路不依赖它。Unterm 是可选组件。",
      "type": "boolean",
      "default": true
    },

    "protocol_versions": {
      "type": "array",
      "items": {
        "$ref": "https://contracts.unzoo.ai/v0/common/primitives.schema.json#/$defs/protocol_version"
      },
      "minItems": 1
    },

    "endpoint": {
      "type": "object",
      "required": ["kind", "address"],
      "properties": {
        "kind": { "enum": ["http", "ws", "ipc", "in_process"] },
        "address": {
          "description": "本机 Provider 常用随机端口，因此地址来自注册文件而不是硬编码。",
          "type": "string",
          "minLength": 1
        }
      }
    },

    "identity": {
      "description": "localhost 也必须认证。Origin/CORS 不能代替认证。",
      "type": "object",
      "required": ["auth"],
      "properties": {
        "auth": { "enum": ["bearer_token", "mtls", "os_pipe_acl"] },
        "client_id": {
          "$ref": "https://contracts.unzoo.ai/v0/common/primitives.schema.json#/$defs/client_id"
        },
        "token_ref": {
          "$ref": "https://contracts.unzoo.ai/v0/common/primitives.schema.json#/$defs/secret_ref"
        },
        "signature": {
          "description": "manifest 签名。校验失败属于 hard deny。",
          "type": "string"
        }
      }
    },

    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool" }
    },

    "health": {
      "type": "object",
      "required": ["state"],
      "properties": {
        "state": { "enum": ["online", "degraded", "offline"] },
        "checked_at": {
          "$ref": "https://contracts.unzoo.ai/v0/common/primitives.schema.json#/$defs/timestamp"
        },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "detail": { "type": "string" }
      }
    }
  },

  "$defs": {
    "tool": {
      "description": "一个工具 = 名字 + 参数 schema + 完整风险声明。三者缺一不予注册。",
      "type": "object",
      "required": ["tool", "title", "arguments_schema", "risk_declaration"],
      "properties": {
        "tool": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z][a-z0-9_]*)+$"
        },
        "title": {
          "description": "面向用户的说法。审批弹窗用它，不用工具名。",
          "type": "string",
          "minLength": 1
        },
        "description": { "type": "string" },
        "arguments_schema": {
          "description": "内嵌 JSON Schema。Core 在 Policy 之前先按它做参数校验。",
          "type": "object"
        },
        "risk_declaration": {
          "$ref": "https://contracts.unzoo.ai/v0/security/risk.schema.json#/$defs/tool_risk_declaration"
        },
        "cancelable": { "type": "boolean", "default": true }
      }
    }
  }
}
